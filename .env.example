# ─────────────────────────────────────────────────────────────
# Nayacura environment example
# Copy to backend/.env for local development.
# Never commit real secrets. Never place service keys in frontend code.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Local demo uses SQLite for a zero-config run.
# For production PostgreSQL, see backend/prisma/schema.postgresql.prisma.
DATABASE_URL="file:./dev.db"

SESSION_TTL_DAYS=7
DEMO_MODE=true
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret
TAX_PERCENT=18
COOKIE_SECURE=false
TRUST_PROXY=0
UPLOAD_DIR=uploads

# Razorpay (server-side only). Leave blank for simulated demo payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LiveKit (server-side token generation). Leave blank for the demo room.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI-compatible LLM endpoint. Leave blank for safe local fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Transactional email. Leave blank to log "email skipped" without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nayacura <no-reply@nayacura.example>"
SUPPORT_EMAIL=support@nayacura.example

# Frontend (optional). By default Vite proxies /api to localhost:4000.
# VITE_API_URL=/api
