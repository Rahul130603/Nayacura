    {
      "dot": "cyan",
      "title": "Patient Consultation Lifecycle",
      "items": [
        "1. Browse & filter specialists by specialization, language, city, and format.",
        "2. Select appointment format (online video or in-person) and timezone-aware slot.",
        "3. Automated 15-minute hold with atomic double-booking conflict prevention in Prisma transaction.",
        "4. Dual payment options: production Razorpay order capture with HMAC-SHA256 signature check, or offline demo adapter."
      ]
    },
    {
      "dot": "emerald",
      "title": "Zero-Trust Security & Privacy",
      "items": [
        "CSRF token and HTTP-only cookie session authentication on all appointment mutating endpoints.",
        "Double-booking protection releases expired holds before checking slot collision in an atomic Prisma transaction.",
        "Timing-safe signature verification prevents timing attack vulnerabilities during payment validation.",
        "Transactional emails deliberately omit sensitive consultation reasons, diagnoses, and patient medical notes."
      ]
    },
    {
      "dot": "violet",
      "title": "Confidential Telehealth & Vault",
      "items": [
        "LiveKit video consultation room with short-lived JWT join tokens issued only within the join window.",
        "Private audio/video tracks streamed peer-to-peer via SFU with end-to-end room isolation.",
        "Post-consultation clinical notes and prescriptions encrypted at the application layer with AES-256-GCM.",
        "Each encrypted record uses random 12-byte IV, scrypt-derived key, and authentication tag for tamper resistance."
      ]
    }
  ]
