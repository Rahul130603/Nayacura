      "dot": "cyan",
      "title": "Voice turn",
      "items": [
        "The browser shows interim recognition results while the user speaks. After a pause, the latest transcript becomes a chat turn.",
        "Naya resumes listening after playback finishes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Captions",
      "items": [
        "Device speech advances captions at the start of each spoken segment.",
        "Piper returns one WAV. The browser estimates caption timing from audio progress and caption length."
      ]
    },
    {
      "dot": "rose",
      "title": "Fallbacks",
      "items": [
        "Without a configured model, the API uses built-in replies. Safety and medicine referrals can also bypass the model.",
        "Piper fallback is available for English and Tamil when the corresponding model is installed on the server."
      ]
    }
