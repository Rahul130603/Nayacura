  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend modules",
      "items": [
        "React Router splits public pages, booking, consultation and three protected dashboards. AuthContext and LoginPortal share the API client; TanStack Query caches data.",
        "Booking and DoctorProfile fetch clinician slots. ConsultationRoom uses LiveKit Client for media once the backend issues a room token. Ask Naya consumes streamed replies."
      ]
    },
    {
      "dot": "violet",
      "title": "Public and account API",
      "items": [
        "/api/auth — registration, login, current user, sessions, email verification and password reset.",
        "/api/doctors — directory, filters, profiles and availability. /api/services, /api/plans, /api/articles and /api/config/public — public content and configuration.",
        "/api/health — checks database connectivity and reports configured integrations."
      ]
    },
    {
      "dot": "emerald",
      "title": "Booking and role APIs",
      "items": [
        "/api/appointments — slot holds, payment orders and verification, rescheduling, cancellation, consent, video tokens and reviews.",
        "/api/patient — appointments, documents, prescriptions, payments, profile and notifications. /api/doctor — schedule, availability, clinical notes, prescriptions and earnings.",
        "/api/admin — clinician verification, user and appointment oversight, refunds, tickets, content, reviews, audit and settings."
      ]
    },
    {
      "dot": "amber",
      "title": "Chat and support APIs",
      "items": [
        "/api/ai/chat streams replies via SSE; /api/ai/conversations manages saved conversations. English, Tamil and Tanglish are supported. Storage requires account and consent.",
        "/api/support/tickets handles contact, ticket history and replies. Admin ticket routes support assignment and responses."
      ]
    },
    {
      "dot": "slate",
      "title": "Module dependencies and persistence",
      "items": [
        "Route handlers call Prisma directly and delegate slot rules, cookie sessions, payment handling, email and serialization to backend services. Validation and authorization guard mutations.",
        "SQL models cover identity, profiles and availability, appointments and status history, payments, clinical records, content, chat, support, consent and audit. Medical document metadata lives in SQL and upload bytes live on disk.",
        "Build selects the Prisma schema from DATABASE_URL. In development Vite proxies /api to Express; production Express serves the built frontend and handles SPA routes."
      ]
    },
    {
      "dot": "rose",
      "title": "Provider behavior",
      "items": [
        "LiveKit uses scoped room tokens after appointment access and consent checks. Without configuration the room offers a local media preview.",
        "payments.ts creates Razorpay orders and verifies payment details; demo payments are simulated. ai.ts uses a configured chat completion provider or fallback replies.",
        "mailer.ts uses configured SMTP for account, booking and support messages. Source references are pinned to the Git commit; provider activation varies by deployment."
      ]
    }
  ]
}
