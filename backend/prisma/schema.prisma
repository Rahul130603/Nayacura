// Nayacura local development schema (SQLite, zero-config).
// Production target: PostgreSQL. See prisma/schema.postgresql.prisma and docs/MIGRATIONS.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  name               String
  role               String               @default("PATIENT")
  emailVerified      Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  patient            PatientProfile?
  doctor             DoctorProfile?
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  aiConversations    AIConversation[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]           @relation("ActorAuditLogs")
  consents           ConsentRecord[]
  documentsUploaded  MedicalDocument[]    @relation("UploadedDocuments")
  ticketMessages     TicketMessage[]
  reviews            Review[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PatientProfile {
  id                      String              @id @default(cuid())
  userId                  String              @unique
  phone                   String?
  ageConfirmed            Boolean             @default(false)
  preferredLanguage       String              @default("en")
  communicationPreference String              @default("EMAIL")
  marketingConsent        Boolean             @default(false)
  aiHistoryEnabled        Boolean             @default(false)
  profileVisibility       String              @default("PRIVATE")
  deletionRequestedAt     DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments            Appointment[]
  documents               MedicalDocument[]
  prescriptions           Prescription[]
  clinicalNotes           ClinicalNote[]
  reviews                 Review[]

  @@index([createdAt])
}

model DoctorProfile {
  id                String                @id @default(cuid())
  userId            String                @unique
  slug              String                @unique
  title             String
  gender            String
  photoUrl          String?
  bio               String
  approach          String
  experienceYears   Int
  languages         String
  feePaise          Int
  followUpFeePaise  Int?
  onlineEnabled     Boolean               @default(true)
  inPersonEnabled   Boolean               @default(true)
  city              String
  timezone          String                @default("Asia/Kolkata")
  verified          Boolean               @default(false)
  status            String                @default("PENDING")
  isDemo            Boolean               @default(true)
  credentialCheckedAt DateTime?
  credentialCheckedBy String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations   DoctorSpecialization[]
  credentials       DoctorCredential[]
  availabilities    DoctorAvailability[]
  clinics           DoctorClinic[]
  appointments      Appointment[]
  clinicalNotes     ClinicalNote[]
  prescriptions     Prescription[]
  reviews           Review[]

  @@index([status, verified])
  @@index([city])
  @@index([feePaise])
}

model Specialization {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  description String?
  doctors     DoctorSpecialization[]
}

model DoctorSpecialization {
  doctorId         String
  specializationId String
  isPrimary        Boolean       @default(false)
  doctor           DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorId, specializationId])
  @@index([specializationId])
}

model DoctorCredential {
  id                 String        @id @default(cuid())
  doctorId           String
  type               String
  title              String
  institution        String?
  registrationNumber String?
  council            String?
  year               Int?
  verified           Boolean       @default(false)
  note               String?
  createdAt          DateTime      @default(now())
  doctor             DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model Clinic {
  id          String         @id @default(cuid())
  name        String
  city        String
  timezone    String         @default("Asia/Kolkata")
  addressNote String?
  isDemo      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  doctors     DoctorClinic[]
  appointments Appointment[]
}

model DoctorClinic {
  doctorId String
  clinicId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic   Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([doctorId, clinicId])
  @@index([clinicId])
}

model DoctorAvailability {
  id          String        @id @default(cuid())
  doctorId    String
  weekday     Int
  startMinute Int
  endMinute   Int
  mode        String        @default("BOTH")
  slotMinutes Int           @default(30)
  active      Boolean       @default(true)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday, active])
}

model ServiceCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String
  description String
  sortOrder   Int       @default(0)
  services    Service[]
}

model Service {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  summary      String
  categoryId   String
  featured     Boolean         @default(false)
  active       Boolean         @default(true)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  appointments Appointment[]

  @@index([categoryId, active])
}

model Appointment {
  id                String                    @id @default(cuid())
  bookingId         String                    @unique
  patientId         String
  doctorId          String
  serviceId         String?
  clinicId          String?
  mode              String
  status            String                    @default("PENDING_PAYMENT")
  startAt           DateTime
  endAt             DateTime
  timezone          String                    @default("Asia/Kolkata")
  reason            String?
  feePaise          Int
  taxPaise          Int
  totalPaise        Int
  videoRoomName     String?
  holdExpiresAt     DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  rescheduledFromId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  patient           PatientProfile            @relation(fields: [patientId], references: [id])
  doctor            DoctorProfile             @relation(fields: [doctorId], references: [id])
  service           Service?                  @relation(fields: [serviceId], references: [id])
  clinic            Clinic?                   @relation(fields: [clinicId], references: [id])
  statusHistory     AppointmentStatusHistory[]
  payment           Payment?
  consultation      Consultation?
  clinicalNotes     ClinicalNote[]
  prescriptions     Prescription[]
  documents         MedicalDocument[]
  review            Review?

  @@index([doctorId, startAt, status])
  @@index([patientId, startAt])
  @@index([status, holdExpiresAt])
  @@index([bookingId])
}

model AppointmentStatusHistory {
  id            String      @id @default(cuid())
  appointmentId String
  status        String
  note          String?
  changedBy     String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model Payment {
  id                String      @id @default(cuid())
  appointmentId     String      @unique
  amountPaise       Int
  taxPaise          Int
  totalPaise        Int
  currency          String      @default("INR")
  status            String      @default("CREATED")
  provider          String      @default("DEMO")
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([status, createdAt])
}

model Refund {
  id          String    @id @default(cuid())
  paymentId   String
  amountPaise Int
  status      String    @default("PENDING")
  reason      String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, status])
}

model Consultation {
  id                String      @id @default(cuid())
  appointmentId     String      @unique
  roomName          String
  status            String      @default("SCHEDULED")
  startedAt         DateTime?
  endedAt           DateTime?
  consentRecordedAt DateTime?
  recordingConsent  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model ClinicalNote {
  id                String      @id @default(cuid())
  appointmentId     String
  doctorId          String
  patientId         String
  encryptedContent  String
  encryptionVersion Int         @default(1)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor            DoctorProfile @relation(fields: [doctorId], references: [id])
  patient           PatientProfile @relation(fields: [patientId], references: [id])

  @@index([appointmentId])
  @@index([patientId, createdAt])
}

model Prescription {
  id                   String         @id @default(cuid())
  appointmentId        String
  doctorId             String
  patientId            String
  encryptedMedications String
  encryptedInstructions String
  encryptionVersion    Int            @default(1)
  status               String         @default("ISSUED")
  issuedAt             DateTime       @default(now())
  appointment          Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor               DoctorProfile  @relation(fields: [doctorId], references: [id])
  patient              PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId, issuedAt])
}

model MedicalDocument {
  id           String        @id @default(cuid())
  patientId    String
  uploadedById String?
  appointmentId String?
  fileName     String
  storageKey   String        @unique
  mimeType     String
  sizeBytes    Int
  category     String        @default("OTHER")
  visibility   String        @default("CARE_TEAM")
  createdAt    DateTime      @default(now())
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])

  @@index([patientId, createdAt])
}

model AIConversation {
  id                String        @id @default(cuid())
  userId            String
  title             String
  language          String        @default("en")
  consentGrantedAt  DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id               String         @id @default(cuid())
  conversationId   String
  role             String
  encryptedContent String
  createdAt        DateTime       @default(now())
  conversation     AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("GENERAL")
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Review {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  doctorId      String
  patientId     String
  userId        String
  rating        Int
  title         String?
  body          String
  status        String        @default("PENDING")
  isIllustrative Boolean      @default(false)
  createdAt     DateTime      @default(now())
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id])
  patient       PatientProfile @relation(fields: [patientId], references: [id])
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([doctorId, status])
}

model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  category        String
  categoryName    String
  content         String
  author          String
  reviewer        String?
  publishedAt     DateTime
  reviewedAt      DateTime?
  readingMinutes  Int
  featured        Boolean   @default(false)
  image           String
  metaTitle       String?
  metaDescription String?
  status          String    @default("DRAFT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category, status])
  @@index([publishedAt])
}

model SupportTicket {
  id          String          @id @default(cuid())
  reference   String          @unique
  userId      String?
  name        String
  email       String
  category    String
  subject     String
  status      String          @default("OPEN")
  priority    String          @default("NORMAL")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User?           @relation(fields: [userId], references: [id])
  messages    TicketMessage[]

  @@index([status, createdAt])
  @@index([email])
}

model TicketMessage {
  id           String        @id @default(cuid())
  ticketId     String
  authorUserId String?
  authorRole   String
  body         String
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
}

model ConsentRecord {
  id        String    @id @default(cuid())
  userId    String
  type      String
  version   String    @default("draft-2026-11")
  granted   Boolean
  ipHash    String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Plan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  pricePaise  Int
  taxPercent  Int      @default(18)
  duration    String
  includes    String
  mode        String   @default("EITHER")
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
